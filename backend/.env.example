# Copie para .env para rodar a API fora do Docker (npm run start:dev).
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://aprovame:aprovame@localhost:5432/aprovame?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# Gere um segredo forte em produção: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao
# O enunciado pede 1 minuto.
JWT_EXPIRES_IN_SECONDS=60

# 1 tentativa + 4 retentativas (nível 8)
BATCH_MAX_ATTEMPTS=5
BATCH_BACKOFF_MS=1000
BATCH_CONCURRENCY=10

# Mailpit local: caixa de entrada em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Aprova-me <nao-responda@aprova.me>"
BATCH_REPORT_EMAIL=cliente@aprova.me
OPERATIONS_EMAIL=operacoes@aprova.me

# Usuário criado pelo seed (nível 5)
SEED_USER_LOGIN=aprovame
SEED_USER_PASSWORD=aprovame
